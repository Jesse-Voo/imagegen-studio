{
  "name": "imagegen-studio",
  "productName": "ImageGen Studio",
  "version": "0.1.0",
  "description": "Desktop app for generating images with Gemini, OpenAI, free and local models, with AI prompt refinement.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "Jesse-Voo",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jessevoo.imagegenstudio",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/lucide/dist/umd/lucide.min.js",
      "node_modules/motion/dist/motion.js",
      "node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "lucide": "^1.69.0",
    "@fontsource-variable/inter": "^5.3.0",
    "motion": "^14.9.1"
  }
}
